# Copy this file to .env, then run `docker compose up -d`.
#
# Only ZKE_POSTGRES_PASSWORD is required. Generate one with `openssl rand -hex 24`
# and keep it URL-safe: it is embedded in PostgreSQL's URL.
ZKE_POSTGRES_PASSWORD=replace_with_a_long_random_url_safe_password

# Optional: pin the Server image instead of tracking the main branch.
# ZKE_SERVER_IMAGE=ghcr.io/togettoyou/zke-server:latest

# Optional host ports. 8080 serves the Console and API, 8081 serves Pod Access,
# and 8443 is UDP for the Agent QUIC/mTLS connection. PostgreSQL is published on
# the host loopback only.
# ZKE_HTTP_PORT=8080
# ZKE_POD_ACCESS_PORT=8081
# ZKE_AGENT_QUIC_PORT=8443
# ZKE_POSTGRES_PORT=5432

# Optional: the address a browser actually uses to reach Pod Access. A gateway in
# front of this listener must preserve its Host header.
# ZKE_POD_ACCESS_EXTERNAL_URL=http://127.0.0.1:8081

# Optional platform default endpoint for new Agent enrollments. Set both or
# neither; unset keeps the local loopback preset, which only works when the Agent
# shares this host's network. More endpoints are managed in Console.
# ZKE_AGENT_INSTALL_PUBLIC_HTTP_URL=http://zke.example.com:8080
# ZKE_AGENT_INSTALL_PUBLIC_QUIC_ADDRESS=zke.example.com:8443
